# NocoDB (direct REST for CRUD/browsing)
NOCODB_URL=http://nocodb.example.com
NOCODB_API_TOKEN=your_nocodb_xc_auth_token
NOCODB_BASE_ID=your_nocodb_base_id

# LLM Provider (ollama|openai-compatible — default: ollama)
LLM_PROVIDER=ollama

# Ollama (direct LLM — recommended for tool calling)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Generic OpenAI-compatible endpoint — any provider that speaks the OpenAI
# chat-completions/embeddings wire protocol (Bifrost, OpenAI, Open-WebUI,
# LiteLLM, OpenRouter, etc.). Recommended value is a Bifrost LLM gateway: it
# adds routing, failover, and cost/observability across backends, and
# manages backend auth itself, so no API key is required from OHM. Use the
# internal Docker network address when it runs as a sibling container (e.g.
# via docker-compose on the same network); use the external address for
# local dev or non-Docker deployments.
OPENAI_COMPATIBLE_URL=http://bifrost:8080/v1
# OPENAI_COMPATIBLE_URL=https://bifrost.example.com/v1
# OPENAI_COMPATIBLE_URL=https://api.openai.com/v1
# OPENAI_COMPATIBLE_API_KEY=sk-...
OPENAI_COMPATIBLE_MODEL=gpt-4o-mini

# UniFi Network API
UNIFI_URL=https://unifi.example.com
UNIFI_USERNAME=admin_user
UNIFI_PASSWORD=admin_pass
UNIFI_SITE=default
UNIFI_VERIFY_SSL=true

# Home Assistant (energy monitoring)
HA_URL=http://homeassistant.example:8123
HA_TOKEN=your_long_lived_access_token

# Emporia Vue entity prefix (for auto-discovery of power sensors)
HA_EMPORIA_PREFIX=sensor.emporia_vue_

# Enphase Solar entities
HA_ENPHASE_PRODUCTION_ENTITY=sensor.enphase_current_power_production
HA_ENPHASE_TODAY_ENTITY=sensor.enphase_today_s_energy_production

# Utility rate in $/kWh (used for cost estimates)
UTILITY_RATE_KWH=0.138

# Demo mode — set to true to run without external services (uses fixture data)
DEMO_MODE=false
